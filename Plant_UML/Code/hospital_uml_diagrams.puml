' =====================================================
' Hospital Management System - UML diagrams (PlantUML)
' Paste any block (from @startuml to @enduml) into
' https://www.plantuml.com/plantuml or a VS Code PlantUML extension.
' =====================================================


' ===================== STRUCTURAL =====================

' ---------- 1. CLASS DIAGRAM ----------
@startuml 01_class_diagram
title Class Diagram - Hospital Management System
skinparam classAttributeIconSize 0

class User {
  - userId : int
  - username : String
  - passwordHash : String
  - role : String
  + login()
  + logout()
}

class Admin {
  + manageDoctors()
  + viewReports()
}

class Receptionist {
  + registerPatient()
  + bookAppointment()
  + generateBill()
}

class Doctor {
  - doctorId : int
  - specialization : String
  - consultationFee : double
  + viewAppointments()
  + addVisitRecord()
}

class Patient {
  - patientId : int
  - name : String
  - age : int
  - gender : String
  - phone : String
  - address : String
  + updateDetails()
}

class Appointment {
  - appointmentId : int
  - date : Date
  - timeSlot : Time
  - status : String
  + book()
  + reschedule()
  + cancel()
}

class VisitRecord {
  - recordId : int
  - symptoms : String
  - diagnosis : String
  - prescription : String
  + save()
}

class Bill {
  - billId : int
  - discount : double
  - totalAmount : double
  - status : String
  + generate()
  + markPaid()
  + print()
}

class BillItem {
  - description : String
  - amount : double
}

User <|-- Admin
User <|-- Receptionist
User <|-- Doctor

Patient "1" -- "0..*" Appointment : has
Doctor "1" -- "0..*" Appointment : attends
Appointment "1" -- "0..1" VisitRecord : produces
Appointment "1" -- "0..1" Bill : billed by
Bill "1" *-- "1..*" BillItem : contains
@enduml


