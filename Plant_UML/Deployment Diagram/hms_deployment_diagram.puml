@startuml HMS_Deployment_Diagram
skinparam node {
  BackgroundColor #F5F9FF
  BorderColor #2E74B5
  FontColor #1F3864
}
skinparam database {
  BackgroundColor #DDEBF7
  BorderColor #2E74B5
}

node "Client Devices" {
  [Browser - Desktop] as BrowserDesktop
  [Browser - Tablet/Mobile] as BrowserMobile
}

cloud "CDN" as CDN

node "Load Balancer" as LB

node "Web/App Server Cluster" as AppCluster {
  node "App Server 1\n(Docker Container)" as App1 {
    component "API Gateway"
    component "Domain Services\n(Patient, Appt, EHR,\nPharmacy, Lab, Billing)"
  }
  node "App Server 2\n(Docker Container)" as App2 {
    component "API Gateway " as GW2
    component "Domain Services " as DS2
  }
}

node "Kubernetes Orchestration" as K8s

database "Primary DB Server\n(PostgreSQL/MongoDB\nPrimary)" as DBPrimary
database "Replica DB Server\n(Read Replica)" as DBReplica

node "Object Storage\n(S3-compatible)" as ObjStore

node "Backup & DR Site" as Backup

cloud "Notification Gateway\n(SMS/Email/WhatsApp API)" as NotifyCloud
cloud "Payment Gateway" as PayCloud
cloud "Insurance/TPA System" as InsCloud

node "Monitoring & Logging\n(Centralized)" as Monitoring

BrowserDesktop --> CDN : HTTPS
BrowserMobile --> CDN : HTTPS
CDN --> LB : HTTPS
LB --> App1 : HTTPS
LB --> App2 : HTTPS

App1 --> DBPrimary : TLS
App2 --> DBPrimary : TLS
App1 --> DBReplica : read
App2 --> DBReplica : read
DBPrimary --> DBReplica : replication
DBPrimary --> Backup : nightly backup

App1 --> ObjStore
App2 --> ObjStore

K8s ..> App1 : orchestrates
K8s ..> App2 : orchestrates

App1 --> NotifyCloud : HTTPS
App2 --> PayCloud : HTTPS
App2 --> InsCloud : HTTPS

App1 --> Monitoring : logs/metrics
App2 --> Monitoring : logs/metrics
DBPrimary --> Monitoring : metrics

@enduml
