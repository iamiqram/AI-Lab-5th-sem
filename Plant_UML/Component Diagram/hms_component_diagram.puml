@startuml HMS_Component_Diagram
skinparam component {
  BackgroundColor #F5F9FF
  BorderColor #2E74B5
  FontColor #1F3864
}
skinparam interface {
  BackgroundColor #DDEBF7
  BorderColor #2E74B5
}

actor Admin
actor Doctor
actor "Front Desk Staff" as FrontDesk
actor Patient

package "Client Tier" {
  [Web Frontend\n(React/Vite/Tailwind)] as Frontend
}

Admin --> Frontend
Doctor --> Frontend
FrontDesk --> Frontend
Patient --> Frontend

interface "REST/GraphQL API" as API_IF

package "Application Tier" {
  [API Gateway] as Gateway
  [Auth & RBAC Service] as Auth
  [Patient Service] as PatientSvc
  [Appointment Service] as ApptSvc
  [EHR Service] as EHRSvc
  [Pharmacy Service] as PharmSvc
  [Lab Service] as LabSvc
  [Billing Service] as BillingSvc
  [Staff Service] as StaffSvc
  [Reporting Service] as ReportSvc
  [Notification Service] as NotifySvc
}

Frontend --> API_IF
API_IF - Gateway

Gateway --> Auth
Gateway --> PatientSvc
Gateway --> ApptSvc
Gateway --> EHRSvc
Gateway --> PharmSvc
Gateway --> LabSvc
Gateway --> BillingSvc
Gateway --> StaffSvc
Gateway --> ReportSvc

EHRSvc --> PharmSvc : prescription lookup
EHRSvc --> LabSvc : lab order
ApptSvc --> NotifySvc : reminders
BillingSvc --> NotifySvc : payment receipts
LabSvc --> NotifySvc : report ready

package "Data Tier" {
  database "Transactional DB\n(PostgreSQL/MongoDB)" as TXDB
  database "Audit Log Store" as AuditDB
  storage "Object Storage\n(S3-compatible)" as ObjStore
}

PatientSvc --> TXDB
ApptSvc --> TXDB
EHRSvc --> TXDB
PharmSvc --> TXDB
LabSvc --> TXDB
BillingSvc --> TXDB
StaffSvc --> TXDB
ReportSvc --> TXDB
Auth --> AuditDB
StaffSvc --> AuditDB
EHRSvc --> ObjStore
LabSvc --> ObjStore

package "External Integrations" {
  [SMS/Email/WhatsApp Gateway] as MsgGW
  [Payment Gateway] as PayGW
  [Insurance/TPA System] as InsSys
}

NotifySvc --> MsgGW
BillingSvc --> PayGW
BillingSvc --> InsSys

@enduml
