@startuml HMS_StateMachine_Diagram
skinparam state {
  BackgroundColor #F5F9FF
  BorderColor #2E74B5
  FontColor #1F3864
}

state "Appointment Lifecycle" as ApptGroup {
  [*] --> Scheduled : book()
  Scheduled --> CheckedIn : patient checks in
  Scheduled --> Cancelled : cancel()
  Scheduled --> NoShow : patient did not arrive
  CheckedIn --> InConsultation : doctor calls patient
  InConsultation --> Completed : consultation ends
  Cancelled --> [*]
  NoShow --> [*]
  Completed --> [*]
}

state "Lab Order Lifecycle" as LabGroup {
  [*] --> Ordered : doctor places order
  Ordered --> SampleCollected : collectSample()
  SampleCollected --> InProgress : lab processing
  InProgress --> Completed2 : enterResults()
  Completed2 --> ResultFlagged : if abnormal
  Completed2 --> ResultNormal : if normal
  ResultFlagged --> [*]
  ResultNormal --> [*]

  state Completed2 as "Completed"
}

state "Bed Lifecycle" as BedGroup {
  [*] --> Vacant
  Vacant --> Occupied : allocate() on admission
  Occupied --> Vacant : release() on discharge
  Vacant --> Maintenance : flagged for cleaning/repair
  Maintenance --> Vacant : maintenance complete
}

state "Invoice Lifecycle" as InvoiceGroup {
  [*] --> Pending : generateInvoice()
  Pending --> PartiallyPaid : partial payment recorded
  Pending --> Paid : full payment recorded
  PartiallyPaid --> Paid : remaining balance paid
  Paid --> Refunded : refund issued
  Refunded --> [*]
  Paid --> [*]
}

@enduml
