@startuml HMS_UseCase_Diagram
left to right direction
skinparam usecase {
  BackgroundColor #F5F9FF
  BorderColor #2E74B5
  FontColor #1F3864
}
skinparam actor {
  BackgroundColor #DDEBF7
  BorderColor #2E74B5
}

actor "Front Desk Staff" as FrontDesk
actor "Patient" as Patient
actor "Doctor" as Doctor
actor "Nurse" as Nurse
actor "Pharmacist" as Pharmacist
actor "Lab Technician" as LabTech
actor "Billing Staff" as Billing
actor "Hospital Administrator" as Admin

rectangle "Hospital Management System" {

  ' --- Registration & Scheduling ---
  usecase "Register New Patient" as UC1
  usecase "Search/Lookup Patient" as UC2
  usecase "Merge Duplicate Records" as UC3
  usecase "Book Appointment" as UC4
  usecase "Reschedule/Cancel Appointment" as UC5
  usecase "Manage Doctor Availability" as UC6
  usecase "Check-in / Token Queue" as UC7

  ' --- Clinical / EHR ---
  usecase "Record Consultation Notes" as UC8
  usecase "Write Prescription" as UC9
  usecase "Order Lab Test" as UC10
  usecase "View Patient History" as UC11
  usecase "Log Vitals" as UC12
  usecase "Administer Medication" as UC13

  ' --- In-Patient ---
  usecase "Allocate Bed" as UC14
  usecase "Admit / Transfer / Discharge Patient" as UC15

  ' --- Pharmacy ---
  usecase "Dispense Medicine" as UC16
  usecase "Manage Drug Inventory" as UC17
  usecase "Raise Purchase Order" as UC18

  ' --- Lab ---
  usecase "Collect Sample" as UC19
  usecase "Enter Lab Results" as UC20
  usecase "Generate Lab Report" as UC21

  ' --- Billing ---
  usecase "Generate Invoice" as UC22
  usecase "Process Payment" as UC23
  usecase "Submit Insurance Claim" as UC24
  usecase "Issue Refund/Discount" as UC25

  ' --- Admin ---
  usecase "Manage Staff & Roles" as UC26
  usecase "View Dashboard & Reports" as UC27
  usecase "View Audit Logs" as UC28

  ' --- Patient portal (phase 2) ---
  usecase "View Own Reports/Prescriptions" as UC29
  usecase "Pay Bill Online" as UC30

  ' --- Cross-cutting ---
  usecase "Receive Notification/Reminder" as UC31
}

FrontDesk --> UC1
FrontDesk --> UC2
FrontDesk --> UC3
FrontDesk --> UC4
FrontDesk --> UC5
FrontDesk --> UC7

Doctor --> UC6
Doctor --> UC8
Doctor --> UC9
Doctor --> UC10
Doctor --> UC11
Doctor --> UC15

Nurse --> UC12
Nurse --> UC13
Nurse --> UC14
Nurse --> UC15

Pharmacist --> UC16
Pharmacist --> UC17
Pharmacist --> UC18

LabTech --> UC19
LabTech --> UC20
LabTech --> UC21

Billing --> UC22
Billing --> UC23
Billing --> UC24
Billing --> UC25

Admin --> UC26
Admin --> UC27
Admin --> UC28

Patient --> UC4
Patient --> UC29
Patient --> UC30

UC4 ..> UC31 : <<include>>
UC22 ..> UC31 : <<include>>
UC21 ..> UC31 : <<include>>
UC9 ..> UC16 : <<extend>>
UC10 ..> UC19 : <<include>>
UC15 ..> UC14 : <<include>>

@enduml
